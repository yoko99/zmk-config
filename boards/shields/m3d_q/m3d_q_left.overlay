#include "m3d_q.dtsi"

/ {
    /* ---------------------------
     * キーマトリクス列の GPIO 定義
     * --------------------------- */
    &k0 {
        col-gpios = <&xiao_d 6 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 3 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 2 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 1 GPIO_ACTIVE_HIGH>,
                    <&xiao_d 0 GPIO_ACTIVE_HIGH>;
    };

    /* ---------------------------
     * RGB LED (左側サムクラスタ内) 定義
     * --------------------------- */
    underglow {
        compatible = "zmk,rgb-underglow";
        gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;   // GPIO5 に接続
        chain-length = <1>;                     // LED 1個
        color-mapping = <0 1 2>;                // RGB順
    };

    /* ---------------------------
     * LED behaviors
     * --------------------------- */
    behaviors {

        /* --- レイヤーLED --- */
        l_base: l_base {
            compatible = "zmk,led-layer";
            layer = <0>;
            color = <0 0 0>;              // Base: 無色
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
        };

        l_media: l_media {
            compatible = "zmk,led-layer";
            layer = <1>;
            color = <255 192 203>;        // Media: ピンク
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
        };

        l_nav: l_nav {
            compatible = "zmk,led-layer";
            layer = <2>;
            color = <0 255 255>;          // Nav: 水色
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
        };

        l_mouse: l_mouse {
            compatible = "zmk,led-layer";
            layer = <3>;
            color = <255 255 0>;          // Mouse: 黄色
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
        };

        l_sym: l_sym {
            compatible = "zmk,led-layer";
            layer = <4>;
            color = <0 255 0>;            // Sym: 緑
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
        };

        l_num: l_num {
            compatible = "zmk,led-layer";
            layer = <5>;
            color = <0 0 255>;            // Num: 青
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
        };

        l_fun: l_fun {
            compatible = "zmk,led-layer";
            layer = <6>;
            color = <255 0 0>;            // Fun: 赤
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
        };

        /* --- Buttonキー長押しLED --- */
        button_hold: button_hold {
            compatible = "zmk,led-layer";
            layer = <7>;                  // 仮レイヤー: Button専用
            color = <255 255 255>;        // 白
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
            // 長押し判定用: Z と / のキーコードに LT または MT を使用
        };

        /* --- BLE 接続LED --- */
        ble_connected: ble_connected {
            compatible = "zmk,led-event";
            event = "zmk_ble_connected";
            color = <0 255 0>;
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
            fade = <500>;
            repeat = <0>;
        };

        ble_disconnected: ble_disconnected {
            compatible = "zmk,led-event";
            event = "zmk_ble_disconnected";
            color = <255 0 0>;
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
            fade = <500>;
            repeat = <0>;
        };

        /* --- BLE ペアリングモードLED --- */
        ble_pairing: ble_pairing {
            compatible = "zmk,led-event";
            event = "zmk_ble_pairing";
            color = <0 0 255>;
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
            fade = <500>;
            repeat = <0>;
        };

        /* --- スリープLED --- */
        sleep_enter: sleep_enter {
            compatible = "zmk,led-event";
            event = "zmk_sleep_enter";
            color = <255 255 255>;
            gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
            fade = <500>;
        };
    };
};
