#include "m3d_q.dtsi"

/* ---------------------------
 * キーマトリクス列の GPIO 定義
 * --------------------------- */
&kscan0 {
    col-gpios = <&xiao_d 6 GPIO_ACTIVE_HIGH>,
                <&xiao_d 3 GPIO_ACTIVE_HIGH>,
                <&xiao_d 2 GPIO_ACTIVE_HIGH>,
                <&xiao_d 1 GPIO_ACTIVE_HIGH>,
                <&xiao_d 0 GPIO_ACTIVE_HIGH>;
};

/ {
    /* ---------------------------
     * Underglow LED (左側のみ)
     * --------------------------- */
    underglow: underglow {
        compatible = "zmk,rgb-underglow";
        gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;
        chain-length = <1>;
        color-mapping = <0 1 2>;  /* 実際の LED チップに合わせて変更可能 */
    };

    chosen {
        zmk,underglow = &underglow;
    };

    /* ---------------------------
     * LED behaviors
     * --------------------------- */
    behaviors {

        /* レイヤーごとのカラー設定 */
        l_base: l_base {
            compatible = "zmk,led-layer";
            layer = <0>;
            color = <0 0 0>;
        };

        l_media: l_media {
            compatible = "zmk,led-layer";
            layer = <1>;
            color = <255 192 203>;
        };

        l_nav: l_nav {
            compatible = "zmk,led-layer";
            layer = <2>;
            color = <0 255 255>;
        };

        l_mouse: l_mouse {
            compatible = "zmk,led-layer";
            layer = <3>;
            color = <255 255 0>;
        };

        l_sym: l_sym {
            compatible = "zmk,led-layer";
            layer = <4>;
            color = <0 255 0>;
        };

        l_num: l_num {
            compatible = "zmk,led-layer";
            layer = <5>;
            color = <0 0 255>;
        };

        l_fun: l_fun {
            compatible = "zmk,led-layer";
            layer = <6>;
            color = <255 0 0>;
        };

        button_hold: button_hold {
            compatible = "zmk,led-layer";
            layer = <7>;
            color = <255 255 255>;
        };

        /* BLE・スリープイベント */
        ble_connected: ble_connected {
            compatible = "zmk,led-event";
            event = "zmk_ble_connected";
            color = <0 255 0>;
            fade = <500>;
            repeat = <0>;
        };

        ble_disconnected: ble_disconnected {
            compatible = "zmk,led-event";
            event = "zmk_ble_disconnected";
            color = <255 0 0>;
            fade = <500>;
            repeat = <0>;
        };

        ble_pairing: ble_pairing {
            compatible = "zmk,led-event";
            event = "zmk_ble_pairing";
            color = <0 0 255>;
            fade = <500>;
            repeat = <0>;
        };

        sleep_enter: sleep_enter {
            compatible = "zmk,led-event";
            event = "zmk_sleep_enter";
            color = <255 255 255>;
            fade = <500>;
        };
    };
};
